{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "**/*.test.ts"
  ],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "references": [
    {
      "path": "../../lib/api-client-react"
    },
    {
      "path": "../../lib/ui"
    },
    {
      "path": "../../lib/engine"
    },
    {
      "path": "../../lib/test-spec"
    },
    {
      "path": "../../lib/forms"
    },
    {
      "path": "../../lib/audio"
    },
    {
      "path": "../../lib/capture"
    },
    {
      "path": "../../lib/asr"
    },
    {
      "path": "../../lib/scoring"
    },
    {
      "path": "../../lib/battery"
    }
  ]
}
