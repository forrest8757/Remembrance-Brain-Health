# Copy to .env (git-ignored) and fill in. Read by `pnpm run start`.
# Deepgram speech-to-text (sign a BAA before any real participant data).
DEEPGRAM_API_KEY=
# Hosted Postgres for comparisons with other participants (and the waitlist).
# After setting it, create the tables: DATABASE_URL=... pnpm --filter @workspace/db push
DATABASE_URL=
# Salt for hashing participant ids in the comparison table. Any long random string.
NORMS_SALT=
